---
export interface Props {
  locale: 'en' | 'zh-CN';
  eyebrow: string;
  title: string;
  description: string;
  primary: { href: string; label: string };
  secondary?: { href: string; label: string };
  featuredRoute: {
    label: string;
    title: string;
    description: string;
    href: string;
    linkLabel: string;
  };
}

const { locale, eyebrow, title, description, primary, secondary, featuredRoute } = Astro.props;
const routeTitleId = `featured-route-${locale}`;
const slipTitleId = `verify-slip-${locale}`;
const zh = locale === 'zh-CN';
const slip = zh
  ? {
      title: '报考前的三个问题',
      note: '这是核验顺序，不是签证、录取或入籍结论',
      rows: [
        ['接收机构', '写上负责收这份材料的机关、学校或雇主'],
        ['证书名称', '打开该机构现在的官方说明，核对它写的证书名称'],
        ['考点状态', '付款前向官方或授权考点确认日期、费用和证件'],
      ],
    }
  : {
      title: 'Three questions before booking',
      note: 'A check order, not a visa, admission, or citizenship decision',
      rows: [
        ['Receiving organisation', 'Name the authority, institution, or employer that receives the file'],
        ['Certificate name', 'Open the current instruction from that organisation and match its wording'],
        ['Centre status', 'Confirm dates, fees, and ID rules with the official or authorised centre before payment'],
      ],
    };
---

<header class="home-hero">
  <div class="home-hero__copy">
    <p class="eyebrow">{eyebrow}</p>
    <h1>{title}</h1>
    <p>{description}</p>
    <div class="home-hero__actions">
      <a class="button button--primary" href={primary.href}>{primary.label}</a>
      {secondary && <a class="button button--secondary" href={secondary.href}>{secondary.label}</a>}
    </div>
  </div>
  <div class="home-hero__visual">
    <aside class="verify-slip" aria-labelledby={slipTitleId}>
      <p class="verify-slip__title" id={slipTitleId}>{slip.title}</p>
      <ol class="verify-slip__list">
        {slip.rows.map(([label, check], index) => (
          <li>
            <span class="verify-slip__index">{String(index + 1).padStart(2, '0')}</span>
            <div>
              <p class="verify-slip__label">{label}</p>
              <p class="verify-slip__check">{check}</p>
            </div>
          </li>
        ))}
      </ol>
      <div class="verify-slip__route" aria-hidden="true">
        <span class="verify-slip__line"></span>
        <span class="verify-slip__end"></span>
      </div>
      <p class="verify-slip__note">{slip.note}</p>
    </aside>
  </div>
</header>

<section class="home-route-spotlight" aria-labelledby={routeTitleId}>
  <p class="home-route-spotlight__label">{featuredRoute.label}</p>
  <div>
    <h2 id={routeTitleId}>{featuredRoute.title}</h2>
    <p>{featuredRoute.description}</p>
  </div>
  <a class="text-link" href={featuredRoute.href}>{featuredRoute.linkLabel}</a>
</section>
