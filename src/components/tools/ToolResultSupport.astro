---
import CopyButton from '../CopyButton.astro';
import PrintButton from '../PrintButton.astro';
import ExportButton from '../ExportButton.astro';
import { commonToolCopy, getToolLinks, type ToolLocale } from '../../data/tool-copy';

export interface Props {
  resultId: string;
  guideHref?: string;
  guideLabel?: string;
  showActions?: boolean;
  locale?: ToolLocale;
}

const { resultId, locale = 'en' } = Astro.props;
const copy = commonToolCopy[locale];
const { guideHref = locale === 'zh-CN' ? '/zh/' : '/guides/', guideLabel = copy.browseGuides } = Astro.props;
const { showActions = true } = Astro.props;
const toolLinks = getToolLinks(locale);
---

<div class="tool-result-support">
  <div class="tool-notice">
    <strong>{copy.supportLead}</strong> {copy.supportBoundary}
  </div>
  <div class="tool-support-grid">
    <section>
      <h2>{copy.officialCheckTitle}</h2>
      <p>{copy.officialCheck}</p>
    </section>
    <section data-tool-continuation>
      <h2>{copy.continueTitle}</h2>
      <p><a href={guideHref}>{guideLabel}</a></p>
      <p><a href={toolLinks.checklist}>{copy.openChecklist}</a> / <a href={toolLinks.timeline}>{copy.openTimeline}</a></p>
    </section>
  </div>
  {showActions && <div class="tool-cta-row"><CopyButton target={`#${resultId}`} locale={locale} /><PrintButton label={copy.print} locale={locale} /><ExportButton target={`#${resultId}`} locale={locale} /></div>}
</div>
