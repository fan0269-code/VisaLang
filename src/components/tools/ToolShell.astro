---
import ToolStepper from '../ToolStepper.astro';
import { commonToolCopy, getToolLinks, type ToolLocale } from '../../data/tool-copy';
import { MEASUREMENT_CONTRACT_VERSION, MEASUREMENT_TRANSPORT } from '../../data/measurement-contract';

export interface Props {
  eyebrow: string;
  title: string;
  description: string;
  current: 'finder' | 'checklist' | 'timeline' | 'comparison' | 'reminders';
  locale?: ToolLocale;
}

const { eyebrow, title, description, current, locale = 'en' } = Astro.props;
const copy = commonToolCopy[locale];
const toolLinks = getToolLinks(locale);
const toolNav = [
  { id: 'finder', label: copy.nav.finder, href: toolLinks.finder },
  { id: 'checklist', label: copy.nav.checklist, href: toolLinks.checklist },
  { id: 'timeline', label: copy.nav.timeline, href: toolLinks.timeline },
  { id: 'comparison', label: copy.nav.comparison, href: toolLinks.comparison },
  { id: 'reminders', label: copy.nav.reminders, href: toolLinks.reminders },
];
---

<main class="page-shell tool-page" data-measurement-tool={current} data-measurement-contract={MEASUREMENT_CONTRACT_VERSION} data-measurement-transport={MEASUREMENT_TRANSPORT}>
  <header class="tool-page-header">
    <p class="eyebrow">{eyebrow}</p>
    <h1>{title}</h1>
    <p>{description}</p>
  </header>
  <nav class="tool-nav" aria-label={copy.navAria}>
    {toolNav.map((tool) => <a class:list={[{ active: tool.id === current }]} href={tool.href} aria-current={tool.id === current ? 'page' : undefined}>{tool.label}</a>)}
  </nav>
  <ToolStepper current={0} labels={[...copy.steps]} />
  <div class="tool-runtime-status" data-tool-runtime-status role="status" aria-live="polite">
    <span data-tool-runtime-message>{copy.runtimeLoading}</span>
    <button class="button button--secondary" type="button" data-tool-retry hidden>{copy.runtimeRetry}</button>
  </div>
  <noscript><style>.tool-runtime-status { display: none; }</style><p class="tool-notice"><strong>{copy.noScriptLead}</strong> {copy.noScript}</p></noscript>
  <slot />
  <details class="tool-plan-controls">
    <summary id="shared-plan-title">{copy.sharedTitle}</summary>
    <div class="tool-plan-controls__body">
      <div>
        <p><strong>{copy.sharedPrivacyLead}</strong> {copy.sharedPrivacy}</p>
        <p><strong>{copy.restartLead}</strong> {copy.restartBoundary}</p>
      </div>
      <div class="button-row tool-plan-actions">
        <button class="button button--secondary" type="button" data-plan-save-device disabled>{copy.save}</button>
        <button class="button button--secondary" type="button" data-plan-clear disabled>{copy.clear}</button>
      </div>
    </div>
  </details>
  <p class="tool-plan-status" data-plan-status aria-live="polite">{copy.initialStatus}</p>
  <div class="button-row"><button class="button button--secondary" type="button" data-tool-restart disabled>{copy.restart}</button></div>
</main>
<script is:inline define:vars={{ runtimeError: copy.runtimeError }}>
  (() => {
    const main = document.querySelector('.tool-page[data-measurement-tool]');
    if (!main) return;
    const status = main.querySelector('[data-tool-runtime-status]');
    const message = main.querySelector('[data-tool-runtime-message]');
    const retry = main.querySelector('[data-tool-retry]');
    main.dataset.toolState = 'initializing';
    main.querySelectorAll('form[inert]').forEach((form) => form.setAttribute('aria-busy', 'true'));
    const ready = () => {
      window.clearTimeout(timeout);
      main.dataset.toolState = 'ready';
      if (status) status.hidden = true;
    };
    const fail = () => {
      if (main.dataset.toolState === 'ready') return;
      window.clearTimeout(timeout);
      main.dataset.toolState = 'failed';
      main.querySelectorAll('form[aria-busy]').forEach((form) => form.removeAttribute('aria-busy'));
      if (message) message.textContent = runtimeError;
      if (retry) retry.hidden = false;
      if (status) status.hidden = false;
    };
    const timeout = window.setTimeout(fail, 12000);
    main.addEventListener('visalang:tool-ready', ready, { once: true });
    retry?.addEventListener('click', () => location.reload());
    window.addEventListener('error', fail);
    window.addEventListener('unhandledrejection', fail);
  })();
</script>
