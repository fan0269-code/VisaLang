---
export interface Props {
  path: { label: string; href?: string }[];
}
const { path } = Astro.props;
---

<nav class="guide-breadcrumb" aria-label={Astro.url.pathname.startsWith('/zh') ? '面包屑导航' : 'Breadcrumb'}>
  {path.map((crumb, i) => (
    <Fragment>
      {i > 0 && <span class="sep" aria-hidden="true">/</span>}
      {crumb.href ? <a href={crumb.href}>{crumb.label}</a> : <span class="current" aria-current="page">{crumb.label}</span>}
    </Fragment>
  ))}
</nav>
