---
import { commonToolCopy, type ToolLocale } from '../data/tool-copy';
export interface Props { label?: string; locale?: ToolLocale; }
const { locale = 'en' } = Astro.props;
const { label = commonToolCopy[locale].print } = Astro.props;
---
<button class="button button--secondary" type="button" data-print-button>{label}</button>
<script>document.querySelectorAll('[data-print-button]').forEach((button) => button.addEventListener('click', () => window.print()));</script>
