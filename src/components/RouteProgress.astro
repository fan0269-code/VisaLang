---
export interface RouteStep { title: string; status: 'current' | 'next' | 'complete'; preparation: string; guide?: { href: string; label: string }; tool?: { href: string; label: string }; }
export interface Props { steps: readonly RouteStep[]; current?: number; routeId?: string; locale?: 'en' | 'zh-CN'; }
const { steps, current = 0, routeId = 'route', locale = 'en' } = Astro.props;
const labels = locale === 'zh-CN' ? { current: '当前步骤', complete: '已完成', next: '下一步', action: '标记完成并继续' } : { current: 'Current step', complete: 'Completed', next: 'Next', action: 'Mark complete and continue' };
---
<ol class="route-progress" aria-label={locale === 'zh-CN' ? '路线进度' : 'Route progress'} data-route-progress={routeId} data-initial-step={current} data-label-current={labels.current} data-label-complete={labels.complete} data-label-next={labels.next} data-storage-message={locale === 'zh-CN' ? '本页进度已更新，但浏览器阻止了保存；刷新后可能无法恢复。' : 'Progress changed on this page, but the browser blocked saving. It may not be restored after a reload.'}>{steps.map((step, index) => <li class:list={[`route-progress__item route-progress__item--${step.status}`, { 'is-current': index === current }]} data-route-step={index} tabindex="-1" aria-current={index === current ? 'step' : undefined}><div class="route-progress__number">{index + 1}</div><div><p class="route-progress__status">{index === current ? labels.current : index < current ? labels.complete : labels.next}</p><h3>{step.title}</h3><p>{step.preparation}</p><div class="route-progress__actions">{step.guide && <a href={step.guide.href}>{step.guide.label}</a>}{step.tool && <a href={step.tool.href}>{step.tool.label}</a>}{index < steps.length - 1 && <button class="button button--secondary" type="button" data-route-next={index} disabled>{labels.action}</button>}</div></div></li>)}</ol>
<p class="tool-plan-status" data-route-storage-status role="status" hidden></p>
<noscript><p class="tool-notice">{locale === 'zh-CN' ? '浏览器未启用 JavaScript；路线链接仍可使用，但无法保存步骤进度。' : 'JavaScript is unavailable. Route links still work, but step progress cannot be saved.'}</p></noscript>
<script>
  document.querySelectorAll<HTMLOListElement>('[data-route-progress]').forEach((progress) => {
    const key = `visalang-route:${progress.dataset.routeProgress}`;
    const parsedInitial = Number(progress.dataset.initialStep || 0);
    const initial = Number.isInteger(parsedInitial) ? parsedInitial : 0;
    const readSaved = () => {
      try {
        const stored = localStorage.getItem(key);
        if (stored === null) return initial;
        const normalized = stored.trim();
        const value = Number(normalized);
        return normalized && Number.isInteger(value) ? value : initial;
      } catch {
        return initial;
      }
    };
    const save = (value: number) => {
      try {
        localStorage.setItem(key, String(value));
        return true;
      } catch {
        return false;
      }
    };
    const saved = Math.max(0, Math.min(progress.children.length - 1, readSaved()));
    const render = (current: number) => {
      progress.querySelectorAll<HTMLElement>('[data-route-step]').forEach((item) => {
        const index = Number(item.dataset.routeStep);
        item.classList.toggle('is-current', index === current);
        item.classList.toggle('is-complete', index < current);
        if (index === current) item.setAttribute('aria-current', 'step'); else item.removeAttribute('aria-current');
        const status = item.querySelector<HTMLElement>('.route-progress__status');
        if (status) status.textContent = index < current ? progress.dataset.labelComplete || 'Completed' : index === current ? progress.dataset.labelCurrent || 'Current step' : progress.dataset.labelNext || 'Next';
      });
    };
    render(saved);
    progress.querySelectorAll<HTMLButtonElement>('[data-route-next]').forEach((button) => button.addEventListener('click', () => {
      const next = Math.min(progress.children.length - 1, Number(button.dataset.routeNext) + 1);
      const persisted = save(next);
      const storageStatus = progress.nextElementSibling;
      if (storageStatus instanceof HTMLElement && storageStatus.matches('[data-route-storage-status]')) {
        storageStatus.hidden = persisted;
        storageStatus.textContent = persisted ? '' : progress.dataset.storageMessage || '';
      }
      render(next);
      progress.querySelector<HTMLElement>(`[data-route-step="${next}"]`)?.focus({ preventScroll: true });
      progress.querySelector<HTMLElement>(`[data-route-step="${next}"]`)?.scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth', block: 'start' });
    }));
    progress.querySelectorAll<HTMLButtonElement>('[data-route-next]').forEach((button) => { button.disabled = false; });
  });
</script>
