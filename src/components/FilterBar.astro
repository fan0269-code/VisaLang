---
export interface Option { value: string; label: string; }
export interface Filter { name: string; label: string; options: Option[]; }
export interface Props { filters: readonly Filter[]; }
const { filters } = Astro.props;
---
<form class="guide-filter-form" data-filter-form data-enhanced-controls>
  <div class="quick-filter-bar">
    {filters.map((filter) => <label><span>{filter.label}</span><select name={filter.name} data-guide-filter disabled><option value="">All {filter.label.toLowerCase()} options</option>{filter.options.map((option) => <option value={option.value}>{option.label}</option>)}</select></label>)}
    <label><span>Sort by</span><select name="sort" data-guide-sort disabled><option value="updated">Recently updated</option><option value="relevance">Route relevance</option></select></label>
  </div>
  <div class="filter-feedback">
    <div class="active-filters" data-active-filters hidden><strong>Active filters</strong><div class="active-filter-list"></div></div>
    <p class="filter-status" aria-live="polite" aria-atomic="true"></p>
    <button class="button button--secondary" type="button" data-clear-all disabled>Clear all</button>
  </div>
</form>
