---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeHero from '../components/HomeHero.astro';
import RouteSelector from '../components/RouteSelector.astro';
import GuideStatusBadge from '../components/GuideStatusBadge.astro';
import homeRouteVisual from '../assets/home-route-verification.png';
import { getCollection } from 'astro:content';
import { resolveGuideContentStatus } from '../data/source-review';
import { getEnglishGuidePublicationPolicy } from '../data/publication-manifest';
import { getPrimaryDiscoveryZhGuides } from '../data/guide-library';
import { site } from '../data/site';
import { zhGermanyA1Guides } from '../data/zh-germany-a1';

const guides = await getCollection('guides');
const publishedGuides = guides
  .map((guide) => ({ ...guide, status: resolveGuideContentStatus(guide.data) }))
  .filter((guide) => getEnglishGuidePublicationPolicy({ slug: guide.data.slug, contentStatus: guide.status, sourceReviewStatus: guide.data.sourceReviewStatus, noindex: guide.data.noindex, adsEligible: guide.data.adsEligible }).index);
const updated = [...publishedGuides]
  .sort((a, b) => b.data.updatedDate.localeCompare(a.data.updatedDate))
  .slice(0, 3);
const totalGuideCount = publishedGuides.length + getPrimaryDiscoveryZhGuides(zhGermanyA1Guides).length;
const publishedCategoryCount = new Set(publishedGuides.map((guide) => guide.data.category)).size;
const jsonLD = { '@context': 'https://schema.org', '@type': 'WebSite', name: site.name, url: `${site.url}/`, description: 'Official-source-first language-proof route decisions.' };
---

<BaseLayout title="German A1 family reunion and B1 language guides" description="Plan German A1 family-reunion language proof and read B1 settlement and citizenship guides. Find official requirements, exam information and planning checklists." canonicalURL="https://visalang.org/" alternates={[{ lang: 'en', href: 'https://visalang.org/' }, { lang: 'zh-CN', href: 'https://visalang.org/zh/' }, { lang: 'x-default', href: 'https://visalang.org/' }]} jsonLD={jsonLD} bodyClass="home-view" enableAds={false} heroPreload={homeRouteVisual}>
  <main class="site-main">
    <HomeHero
      locale="en"
      eyebrow="Official sources first"
      title="Plan your German language proof."
      description="Start with your application route, understand the evidence you may need, and organise your next steps before booking an exam."
      primary={{ href: '/germany-family-reunion-a1/', label: 'Start the Germany A1 route' }}
      secondary={{ href: '/germany-b1-settlement-citizenship/', label: 'Read Germany B1 guides' }}
      visual={homeRouteVisual}
      visualAlt="An open notebook and route map arranged for checking language-proof requirements"
      featuredRoute={{
        label: 'Main planning route',
        title: 'Germany A1 family reunion',
        description: 'Our main planning route covers Germany A1 family reunion. Separate guides explain B1 language evidence for settlement permits and citizenship.',
        href: '/germany-family-reunion-a1/',
        linkLabel: 'View Germany A1 route',
      }}
    />

    <hr class="rule" />

    <section class="section" aria-labelledby="stage-title">
      <h2 class="section-title" id="stage-title">Start with one of three tasks</h2>
      <div class="lane-grid">
        <ol class="stage-list">
          <li class="stage-card"><div><h3>Check the requirement</h3><p>Start with the official instruction for your application location and family-reunion category, including any exception question.</p><a href="/guides/german-family-reunion-language-requirement/">Check the requirement</a></div></li>
          <li class="stage-card"><div><h3>Choosing between exams?</h3><p>Compare Goethe A1 and telc A1 as verification options before booking; the receiving authority decides what it accepts.</p><a href="/guides/goethe-a1-vs-telc-a1/">Choosing between exams?</a></div></li>
          <li class="stage-card"><div><h3>Prepare booking and next steps</h3><p>Record only the centre, fee, date, ID and certificate arrangements you have verified for the selected exam.</p><a href="/guides/german-a1-exam-booking-timeline/">Prepare booking and next steps</a></div></li>
        </ol>
        <aside class="sidebar-panel">
          <h3>The receiving organisation makes the decision.</h3>
          <p>Use its current instructions to confirm the required level, accepted proof, document format, deadline, and any individual exception.</p>
          <ul class="check-list">
            <li>Check the authority or institution receiving the file.</li>
            <li>Check the official exam owner or authorised centre.</li>
            <li>Recheck changing terms before booking or submission.</li>
          </ul>
        </aside>
      </div>
    </section>

    <hr class="rule" />

    <section class="section" aria-labelledby="resources-title">
      <h2 class="section-title" id="resources-title">Enter through tools or guides</h2>
      <p class="section-lede">Tools narrow the route. Guides explain the boundary, official checks, and supporting evidence.</p>
      <div class="resource-layout">
        <div class="resource-lead">
          <h3>Use Route Finder to organise a starting question.</h3>
          <p>Route Finder organises your starting questions. Its fully configured route currently covers Germany A1 family reunion.</p>
          <div class="button-row"><a class="button button--primary" href="/tools/route-finder/">Open Route Finder</a></div>
        </div>
        <div class="resource-list">
          <a class="resource-link" href="/tools/route-finder/"><div><h3>Route Finder</h3><p>Start from purpose, country, and current instruction status.</p></div><span>Use</span></a>
          <a class="resource-link" href="/germany-b1-settlement-citizenship/"><div><h3>Germany B1 guides</h3><p>Separate guides for settlement permits and citizenship; verify the applicable authority route before relying on any proof.</p></div><span>Browse</span></a>
          <a class="resource-link" href="/germany-family-reunion-a1/"><div><h3>Germany A1 family reunion</h3><p>A configured planning route for staged requirement, exam, booking, and document checks.</p></div><span>Start</span></a>
        </div>
      </div>
    </section>

    <hr class="rule" />

    <section class="section section--tight" aria-labelledby="purpose-title">
      <h2 class="section-title" id="purpose-title">What are you trying to do?</h2>
      <p class="section-lede">Start with the decision that brings you here. The receiving authority or institution sets the rule.</p>
      <RouteSelector />
    </section>

    <section class="section" aria-labelledby="updated-title">
      <div class="section-header"><h2 id="updated-title">Recently updated</h2><p>{totalGuideCount} English and Chinese guides across {publishedCategoryCount} developed route categories.</p></div>
      <div class="latest-layout">
        {updated[0] && <a class="latest-feature" href={`/guides/${updated[0].data.slug}/`}><GuideStatusBadge status={updated[0].status} /><h3>{updated[0].data.title}</h3><p>{updated[0].data.description}</p><span class="last-checked">Updated {updated[0].data.updatedDate}</span></a>}
        <div class="latest-list">{updated.slice(1).map((guide) => <a class="latest-item" href={`/guides/${guide.data.slug}/`}><div><h3>{guide.data.title}</h3><p>{guide.data.description}</p></div><span class="last-checked">Updated {guide.data.updatedDate}</span></a>)}</div>
      </div>
    </section>

    <section class="section section--tight" aria-labelledby="trust-title">
      <h2 class="section-title" id="trust-title">Trust comes from clear boundaries</h2>
      <p class="trust-statement"><strong>Route first. No invented facts.</strong> Identify the receiving organisation, then verify changing requirements with its official source before choosing an exam. When a stable source is missing, use the verification task provided. Governments, institutions, exam owners, and authorised centres remain the final source for requirements, acceptance, fees, dates, and individual outcomes.</p>
    </section>
  </main>
</BaseLayout>
