---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeHero from '../components/HomeHero.astro';
import RouteSelector from '../components/RouteSelector.astro';
import GuideStatusBadge from '../components/GuideStatusBadge.astro';
import homeRouteVisual from '../assets/home-route-verification.png';
import { getCollection } from 'astro:content';
import { isGuidePrimaryDiscoveryEligible, resolveGuideContentStatus } from '../data/source-review';
import { site } from '../data/site';
import { zhGermanyA1Guides } from '../data/zh-germany-a1';

const guides = await getCollection('guides');
const publishedGuides = guides
  .map((guide) => ({ ...guide, status: resolveGuideContentStatus(guide.data) }))
  .filter((guide) => isGuidePrimaryDiscoveryEligible(guide.status, guide.data.sourceReviewStatus) && guide.data.noindex !== true);
const updated = [...publishedGuides]
  .sort((a, b) => b.data.updatedDate.localeCompare(a.data.updatedDate))
  .slice(0, 3);
const totalGuideCount = publishedGuides.length + zhGermanyA1Guides.length;
const publishedCategoryCount = new Set(publishedGuides.map((guide) => guide.data.category)).size;
const jsonLD = { '@context': 'https://schema.org', '@type': 'WebSite', name: site.name, url: `${site.url}/`, description: 'Official-source-first language-proof route decisions.' };
---

<BaseLayout title="Find the language proof required for your route" description="Choose a route, identify the language proof to verify, compare exams, and plan your next official check." canonicalURL="https://visalang.org/" alternates={[{ lang: 'en', href: 'https://visalang.org/' }, { lang: 'zh-CN', href: 'https://visalang.org/zh/' }, { lang: 'x-default', href: 'https://visalang.org/' }]} jsonLD={jsonLD} bodyClass="home-view" enableAds={true} heroPreload={homeRouteVisual}>
  <main class="site-main">
    <HomeHero
      locale="en"
      eyebrow="Official sources first"
      title="Verify language proof first."
      description="Identify the receiving organisation, compare accepted exams, and return to the current official instruction."
      primary={{ href: '/tools/route-finder/', label: 'Use Route Finder' }}
      secondary={{ href: '/guides/', label: 'Browse guides' }}
      visual={homeRouteVisual}
      visualAlt="An open notebook and route map arranged for checking language-proof requirements"
      featuredRoute={{
        label: 'Best-developed route',
        title: 'Germany A1 family reunion',
        description: 'Check whether language proof applies, which certificate the receiving authority accepts, and what the selected official centre currently requires.',
        href: '/germany-family-reunion-a1/',
        linkLabel: 'View Germany A1 route',
      }}
    />

    <hr class="rule" />

    <section class="section" aria-labelledby="stage-title">
      <h2 class="section-title" id="stage-title">Make the decision in four checks</h2>
      <div class="lane-grid">
        <ol class="stage-list">
          <li class="stage-card"><div><h3>Identify the receiving organisation</h3><p>Start with the authority, institution, employer, regulator, or exam body that will receive your proof.</p><a href="/tools/route-finder/">Choose a purpose</a></div></li>
          <li class="stage-card"><div><h3>Confirm the proof level</h3><p>Check the source that receives your file before treating any A1, B1, B2, or other level as suitable.</p><a href="/guides/">Browse level guides</a></div></li>
          <li class="stage-card"><div><h3>Compare accepted exams</h3><p>The same level can map to different certificates. Acceptance depends on the receiving organisation.</p><a href="/tools/exam-comparison/">Compare exams</a></div></li>
          <li class="stage-card"><div><h3>Verify before acting</h3><p>Recheck centre status, dates, fees, ID rules, result timing, and submission requirements before payment.</p><a href="/tools/checklist-generator/">Build a checklist</a></div></li>
        </ol>
        <aside class="sidebar-panel">
          <h3>The receiving organisation makes the decision.</h3>
          <p>Use its current instructions to confirm the required level, accepted proof, document format, deadline, and any individual exception.</p>
          <ul class="check-list">
            <li>Check the authority or institution receiving the file.</li>
            <li>Check the official exam owner or authorised centre.</li>
            <li>Recheck changing terms before booking or submission.</li>
          </ul>
        </aside>
      </div>
    </section>

    <hr class="rule" />

    <section class="section" aria-labelledby="resources-title">
      <h2 class="section-title" id="resources-title">Enter through tools or guides</h2>
      <p class="section-lede">Tools narrow the route. Guides explain the boundary, official checks, and supporting evidence.</p>
      <div class="resource-layout">
        <div class="resource-lead">
          <h3>Use a tool when the route is unclear.</h3>
          <p>If you do not know which language proof matters, begin with the route finder instead of reading a long list first.</p>
          <div class="button-row"><a class="button button--primary" href="/tools/route-finder/">Use Route Finder</a></div>
        </div>
        <div class="resource-list">
          <a class="resource-link" href="/tools/route-finder/"><div><h3>Route Finder</h3><p>Start from purpose, country, and current instruction status.</p></div><span>Use</span></a>
          <a class="resource-link" href="/guides/"><div><h3>Guide library</h3><p>Filter explainers by purpose, route, exam, level, and verification status.</p></div><span>Browse</span></a>
          <a class="resource-link" href="/germany-family-reunion-a1/"><div><h3>Germany A1 route</h3><p>The most developed route for staged requirement, exam, booking, and document checks.</p></div><span>View</span></a>
        </div>
      </div>
    </section>

    <hr class="rule" />

    <section class="section section--tight" aria-labelledby="purpose-title">
      <h2 class="section-title" id="purpose-title">What are you trying to do?</h2>
      <p class="section-lede">Start with the decision that brings you here. The receiving authority or institution sets the rule.</p>
      <RouteSelector />
    </section>

    <section class="section" aria-labelledby="updated-title">
      <div class="section-header"><h2 id="updated-title">Recently updated</h2><p>{totalGuideCount} English and Chinese guides across {publishedCategoryCount} developed route categories.</p></div>
      <div class="latest-layout">
        {updated[0] && <a class="latest-feature" href={`/guides/${updated[0].data.slug}/`}><GuideStatusBadge status={updated[0].status} /><h3>{updated[0].data.title}</h3><p>{updated[0].data.description}</p><span class="last-checked">Updated {updated[0].data.updatedDate}</span></a>}
        <div class="latest-list">{updated.slice(1).map((guide) => <a class="latest-item" href={`/guides/${guide.data.slug}/`}><div><h3>{guide.data.title}</h3><p>{guide.data.description}</p></div><span class="last-checked">Updated {guide.data.updatedDate}</span></a>)}</div>
      </div>
    </section>

    <section class="section section--tight" aria-labelledby="trust-title">
      <h2 class="section-title" id="trust-title">Trust comes from clear boundaries</h2>
      <p class="trust-statement"><strong>Route first. No invented facts.</strong> Identify the receiving organisation, then verify changing requirements with its official source before choosing an exam. When a stable source is missing, use the verification task provided. Governments, institutions, exam owners, and authorised centres remain the final source for requirements, acceptance, fees, dates, and individual outcomes.</p>
    </section>
  </main>
</BaseLayout>
