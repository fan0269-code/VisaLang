---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HomeHero from '../../components/HomeHero.astro';
import { getCollection } from 'astro:content';
import { zhGermanyA1Guides } from '../../data/zh-germany-a1';
import RouteSelector from '../../components/RouteSelector.astro';
import GuideStatusBadge from '../../components/GuideStatusBadge.astro';
import homeRouteVisual from '../../assets/home-route-verification.png';
import { isGuidePrimaryDiscoveryEligible, resolveGuideContentStatus } from '../../data/source-review';
import { getEnglishGuidePublicationPolicy } from '../../data/publication-manifest';
import { getPrimaryDiscoveryZhGuides } from '../../data/guide-library';

const guides = await getCollection('guides');
const publishedGuides = guides
  .map((guide) => ({ ...guide, status: resolveGuideContentStatus(guide.data) }))
  .filter((guide) => getEnglishGuidePublicationPolicy({ slug: guide.data.slug, contentStatus: guide.status, sourceReviewStatus: guide.data.sourceReviewStatus, noindex: guide.data.noindex, adsEligible: guide.data.adsEligible }).index);
const publishedZhGuides = getPrimaryDiscoveryZhGuides(zhGermanyA1Guides);
const totalGuideCount = publishedGuides.length + publishedZhGuides.length;
const publishedCategoryCount = new Set(publishedGuides.map((guide) => guide.data.category)).size;
const zhUpdated = publishedZhGuides.slice(0, 3);

const jsonLD = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'VisaLang',
  url: 'https://visalang.org/zh/',
  description: 'VisaLang 帮助用户根据签证、永居、入籍、留学或职业注册需求，找到正确的语言考试路径。',
  inLanguage: 'zh-CN',
};
---

<BaseLayout
  title="德国团聚 A1、永居与入籍 B1 语言证明指南"
  description="了解德国配偶团聚 A1 语言证明，以及永居、入籍 B1 指南（英文内容）；查找官方要求，整理考试报名与材料准备步骤。"
  canonicalURL="https://visalang.org/zh/"
  lang="zh-CN"
  alternates={[
    { lang: 'en', href: 'https://visalang.org/' },
    { lang: 'zh-CN', href: 'https://visalang.org/zh/' },
    { lang: 'x-default', href: 'https://visalang.org/' },
  ]}
  jsonLD={jsonLD}
  bodyClass="home-view"
  heroPreload={homeRouteVisual}
>
  <main class="site-main">
    <HomeHero
      locale="zh-CN"
      eyebrow="官方来源优先"
      title="把德国语言证明的准备步骤理清楚。"
      description="先确认申请要求，再选择考试，最后安排报名和材料。VisaLang 目前重点提供德国 A1 配偶团聚规划，并提供德国永居、入籍 B1 语言证明的英文指南。"
      primary={{ href: '/zh/guides/german-family-reunion-language-requirement/', label: '查看中文 A1 要求' }}
      secondary={{ href: '/germany-b1-settlement-citizenship/', label: '查看 B1 指南（英文）' }}
      visual={homeRouteVisual}
      visualAlt="用于核验语言证明要求的笔记本与路线图"
      featuredRoute={{
        label: '当前中文重点路线',
        title: '德国配偶团聚 / 家庭团聚 A1',
        description: '从是否需要 A1 开始，依次核验证书、考点、报名、材料与备考安排。',
        href: '/zh/germany-family-reunion-a1/',
        linkLabel: '进入德国 A1 中文路线',
      }}
    />

    <hr class="rule" />

    <section class="section" aria-labelledby="zh-stage-title">
      <h2 class="section-title" id="zh-stage-title">按三个问题往下准备</h2>
      <div class="lane-grid">
        <ol class="stage-list">
          <li class="stage-card"><div><h3>需要什么？</h3><p>找到与你的申请地和居留类别对应的官方要求。</p><a href="/zh/guides/german-family-reunion-language-requirement/">查看中文 A1 要求</a></div></li>
          <li class="stage-card"><div><h3>提交什么证明？</h3><p>核对准确证书名称和考试日期；已有证书是否被受理，仍须向负责你申请的机关确认。</p><a href="/zh/guides/goethe-a1-vs-telc-a1/">比较 Goethe 与 telc</a></div></li>
          <li class="stage-card"><div><h3>如何安排？</h3><p>把考点、费用、日期、证件和取证事项记在一起，并在行动前再次核验。</p><a href="/zh/guides/german-a1-exam-booking-timeline/">查看时间线与材料核对</a></div></li>
        </ol>
        <aside class="sidebar-panel">
          <h3>最终以接收材料的机构为准。</h3>
          <p>本站帮助你整理问题与核验顺序，不替代主管机关或考试主办方作出决定。</p>
          <ul class="check-list">
            <li>核对负责你申请地和个案的官方机构。</li>
            <li>核对考试主办方与所选官方或授权考点。</li>
            <li>保存页面、回复、报名确认和查看日期。</li>
          </ul>
        </aside>
      </div>
    </section>

    <hr class="rule" />

    <section class="section" aria-labelledby="zh-resources-title">
      <h2 class="section-title" id="zh-resources-title">从工具或指南进入</h2>
      <p class="section-lede">工具帮助缩小路线，指南说明核验边界、官方入口与下一步。</p>
      <div class="resource-layout">
        <div class="resource-lead">
          <h3>需要整理起点时，可使用工具。</h3>
          <p>路线查找器目前完整配置的是德国 A1 家庭团聚；路线、核对清单、时间线、考试比较和提醒均提供中文界面。</p>
          <div class="button-row"><a class="button button--primary" href="/zh/tools/route-finder/">使用路线查找器</a></div>
        </div>
        <div class="resource-list">
          <a class="resource-link" href="/zh/tools/route-finder/"><div><h3>路线查找器</h3><p>从目的、国家和当前说明状态开始。</p></div><span>使用</span></a>
          <a class="resource-link" href="/germany-b1-settlement-citizenship/"><div><h3>德国 B1 指南（英文）</h3><p>分别阅读永居与入籍的语言证明指南；不要把它当作完整的路线判断。</p></div><span>浏览</span></a>
          <a class="resource-link" href="/zh/germany-family-reunion-a1/"><div><h3>德国 A1 中文路线</h3><p>按照决定顺序查看目前最完整的中文专题。</p></div><span>查看</span></a>
        </div>
      </div>
    </section>

    <hr class="rule" />

    <section class="section section--tight" aria-labelledby="zh-purpose-title">
      <h2 class="section-title" id="zh-purpose-title">你准备办理什么？</h2>
      <p class="section-lede">德国 A1 家庭团聚已有完整中文路径，其余入口会明确进入英文页面。</p>
      <RouteSelector locale="zh-CN" />
    </section>

    <section class="section" id="zh-guides" aria-labelledby="zh-guides-title">
      <div class="section-header"><h2 id="zh-guides-title">最近更新的中文指南</h2><p>当前中英文主资料库共 {totalGuideCount} 篇指南，覆盖 {publishedCategoryCount} 个已发布路线分类。</p></div>
      <div class="latest-layout">
        {zhUpdated[0] && <a class="latest-feature" href={zhUpdated[0].href}><GuideStatusBadge status={zhUpdated[0].contentStatus} locale="zh-CN" /><h3>{zhUpdated[0].title}</h3><p>{zhUpdated[0].description}</p><span class="last-checked">更新于 {zhUpdated[0].updatedDate}</span></a>}
        <div class="latest-list">{zhUpdated.slice(1).map((guide) => <a class="latest-item" href={guide.href}><div><h3>{guide.title}</h3><p>{guide.description}</p></div><span class="last-checked">更新于 {guide.updatedDate}</span></a>)}</div>
      </div>
    </section>

    <section class="section section--tight" aria-labelledby="zh-trust-title">
      <h2 class="section-title" id="zh-trust-title">可信度来自清楚的边界</h2>
      <p class="trust-statement"><strong>路线优先，不编造事实。</strong>先识别接收材料的机构，再用其当前官方说明核验语言等级、证明、材料形式、期限和个案例外。政府机关、学校、雇主、考试主办方与所选考点仍是相应要求的最终来源。</p>
    </section>
  </main>
</BaseLayout>
