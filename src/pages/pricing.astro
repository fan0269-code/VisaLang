---
import CommercialPageShell from '../components/products/CommercialPageShell.astro';
import CommercialBoundary from '../components/products/CommercialBoundary.astro';
import IntentCTA from '../components/products/IntentCTA.astro';
import { commercialLinks } from '../data/commercial-offers';
---

<CommercialPageShell
  status="available"
  eyebrow="Available help"
  title="Use VisaLang’s free planning tools"
  description="See what VisaLang currently provides and what is not available."
  summary="VisaLang currently provides free, self-serve guides and planning tools. There is no paid checkout or paid review service."
  updated="2026-09-11"
>
  <h2>What is available today</h2>
  <p><strong>Free Tools</strong> are available now. They help you organise questions, check a route, compare official-provider details, and plan a timeline. They do not decide a visa, certificate acceptance, exam availability, or individual outcome.</p>

  <h2>Not available today</h2>
  <p>A1 download packs, human Route Review, and AI writing correction are not available. VisaLang has no waitlist, update subscription, checkout, payment collection, delivery promise, or review intake for these items. If that changes, this page will state the exact access, price, delivery, support, privacy, and refund terms.</p>

  <IntentCTA href={commercialLinks.tools} title="Start with the free route tools" description="Use a free tool to organise your next decision and the official questions you still need to confirm." label="Open Route Finder" />
  <CommercialBoundary includeLegalBoundary={true} />
</CommercialPageShell>
