---
import BaseLayout from '../layouts/BaseLayout.astro';
const copy = {
  title: 'Page not found',
  description: 'The page you are looking for does not exist. Search the reviewed guide library or restart from the decision you need to make.',
  heading: 'This page has moved off route.',
  intro: 'The address may be old or mistyped. Search the reviewed guide library, or restart from the decision you need to make.',
  searchLabel: 'Search the reviewed guide library',
  searchHelp: 'Try a country, route, exam, level, or task.',
  placeholder: 'Example: Germany family reunion A1',
  searchAction: 'Search guides',
  fallbackLead: 'Search filtering needs JavaScript. You can still',
  fallbackLink: 'browse all reviewed guides',
  optionsTitle: 'Choose another starting point',
  optionsAria: 'Recovery options',
  options: [
    { href: '/tools/route-finder/', title: 'Use Route Finder', text: 'Identify the authority and proof questions to verify first.' },
    { href: '/guides/', title: 'Browse all reviewed guides', text: 'Filter the primary library by purpose, country, route, exam, level, or language.' },
    { href: '/', title: 'Return to the homepage', text: 'Restart from VisaLang’s available routes and planning tools.' },
  ],
};
---

<BaseLayout title={copy.title} description={copy.description} lang="en" noindex={true} enableAds={false}>
  <main class="page-shell not-found-page">
    <section class="not-found-recovery" aria-labelledby="not-found-title">
      <header class="not-found-heading">
        <p class="not-found-code" aria-hidden="true">404</p>
        <div><h1 id="not-found-title">{copy.heading}</h1><p>{copy.intro}</p></div>
      </header>
      <form class="not-found-search" action="/guides/" method="get">
        <label for="not-found-query"><strong>{copy.searchLabel}</strong><span>{copy.searchHelp}</span></label>
        <div class="not-found-search__controls">
          <input id="not-found-query" name="q" type="search" placeholder={copy.placeholder} autocomplete="off" enterkeyhint="search" />
          <button class="button button--primary" type="submit">{copy.searchAction}</button>
        </div>
        <noscript><p class="not-found-search__fallback">{copy.fallbackLead} <a href="/guides/">{copy.fallbackLink}</a>.</p></noscript>
      </form>
      <nav class="not-found-options" aria-label={copy.optionsAria}>
        <h2>{copy.optionsTitle}</h2>
        <ul>{copy.options.map((option) => <li><a class="not-found-option" href={option.href}><strong>{option.title}</strong><span>{option.text}</span></a></li>)}</ul>
      </nav>
      <p class="not-found-search__fallback">Looking for the Chinese site? <a href="/zh/" lang="zh-CN" hreflang="zh-CN">中文首页</a></p>
    </section>
  </main>
</BaseLayout>
