---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" description="The page you are looking for does not exist." noindex={true} enableAds={false}>
  <main class="page-shell not-found-page">
    <section class="not-found-recovery" aria-labelledby="not-found-title">
      <header class="not-found-heading">
        <p class="not-found-code" aria-hidden="true">404</p>
        <div>
          <h1 id="not-found-title">This page has moved off route.</h1>
          <p>The address may be old or mistyped. Search the reviewed guide library, or restart from the decision you need to make.</p>
        </div>
      </header>

      <form class="not-found-search" action="/guides/" method="get">
        <label for="not-found-query">
          <strong>Search the reviewed guide library</strong>
          <span>Try a country, route, exam, level, or task.</span>
        </label>
        <div class="not-found-search__controls">
          <input id="not-found-query" name="q" type="search" placeholder="Example: Germany family reunion A1" autocomplete="off" enterkeyhint="search" />
          <button class="button button--primary" type="submit">Search guides</button>
        </div>
      </form>

      <nav class="not-found-options" aria-label="Recovery options">
        <h2>Choose another starting point</h2>
        <ul>
          <li>
            <a class="not-found-option" href="/tools/route-finder/">
              <strong>Use Route Finder</strong>
              <span>Identify the authority and proof questions to verify first.</span>
            </a>
          </li>
          <li>
            <a class="not-found-option" href="/guides/">
              <strong>Browse all reviewed guides</strong>
              <span>Filter the primary library by purpose, country, route, exam, level, or language.</span>
            </a>
          </li>
          <li>
            <a class="not-found-option" href="/">
              <strong>Return to the homepage</strong>
              <span>Restart from VisaLang’s available routes and planning tools.</span>
            </a>
          </li>
        </ul>
      </nav>
    </section>
  </main>
</BaseLayout>
