---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ArticleCard from '../../../components/ArticleCard.astro';
import GuideStatusBadge from '../../../components/GuideStatusBadge.astro';
import { categoryContentStatus, guideCategories, guideCategoryIntro, guideCategoryMap, guidePurposeLabels, inferGuideMeta } from '../../../data/guide-taxonomy';
import { contentStatusCtas, resolveGuideContentStatus } from '../../../data/source-review';
import { getCategoryPublicationPolicy, getEnglishGuidePublicationPolicy } from '../../../data/publication-manifest';

export function getStaticPaths() {
  return guideCategories.map((category) => ({
    params: { category: category.slug },
    props: { category },
  }));
}

const { category } = Astro.props;
const guides = await getCollection('guides');
const allCategoryGuides = guides
  .filter((guide) => guide.data.category === category.slug)
  .map((guide) => ({ ...guide, meta: inferGuideMeta(guide.data), status: resolveGuideContentStatus(guide.data) }))
  .sort((a, b) => b.data.publishedDate.localeCompare(a.data.publishedDate));
const categoryGuides = allCategoryGuides
  .filter((guide) => getEnglishGuidePublicationPolicy({ slug: guide.data.slug, contentStatus: guide.status, sourceReviewStatus: guide.data.sourceReviewStatus, noindex: guide.data.noindex, adsEligible: guide.data.adsEligible }).index);
const withheldGuideCount = allCategoryGuides.length - categoryGuides.length;

const canonicalURL = `https://visalang.org/guides/category/${category.slug}/`;
const indexEligible = getCategoryPublicationPolicy(category.slug).index;
const categoryIntro = guideCategoryIntro(category);
const categoryStatus = categoryContentStatus(allCategoryGuides.map((guide) => guide.status));
const categoryPurposes = category.purposes.map((purpose) => guidePurposeLabels[purpose]).join(', ');
const categoryCtas = contentStatusCtas(categoryStatus, { routeHref: `/guides/category/${category.slug}/` });
const jsonLD = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      '@id': `${canonicalURL}#collection`,
      name: `${category.name} guides`,
      url: canonicalURL,
      description: `VisaLang guides for ${category.desc}.`,
      inLanguage: 'en',
      isPartOf: { '@type': 'WebSite', name: 'VisaLang', url: 'https://visalang.org/' },
      mainEntity: { '@id': `${canonicalURL}#item-list` },
    },
    {
      '@type': 'ItemList',
      '@id': `${canonicalURL}#item-list`,
      name: `${category.name} guide list`,
      numberOfItems: categoryGuides.length,
      itemListElement: categoryGuides.map((guide, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        url: `https://visalang.org/guides/${guide.data.slug}/`,
        name: guide.data.title,
        description: guide.data.description,
      })),
    },
  ],
};
---

<BaseLayout
  title={`${category.name} guides`}
  description={`Browse VisaLang ${category.name} guides for ${category.desc}. Compare exams, levels, route checks, official sources, and next steps.`}
  canonicalURL={canonicalURL}
  jsonLD={jsonLD}
  noindex={!indexEligible}
  enableAds={false}
>
  <main class="site-main">
    <section class="section-inner">
      <header class="library-header">
        <p class="eyebrow">Guide category</p>
        <h1>{category.name} guides</h1>
        <p><GuideStatusBadge status={categoryStatus} /></p>
        <p><strong>Purposes:</strong> {categoryPurposes}</p>
        <p>
          {categoryGuides.length} guide{categoryGuides.length === 1 ? '' : 's'} currently listed in the Guide Library for {category.desc}. {categoryIntro}
        </p>
        {withheldGuideCount > 0 && <p>{withheldGuideCount} additional research guide{withheldGuideCount === 1 ? ' remains' : 's remain'} available by direct link but {withheldGuideCount === 1 ? 'is' : 'are'} not listed here while {withheldGuideCount === 1 ? 'its' : 'their'} official sources and distinct reader task are still being checked.</p>}
        <p>Before booking, verify the current requirement with the authority or institution receiving your proof; then verify the exact test, authorised centre, fee, date, ID rule, and result process with official sources.</p>
        <div class="action-row left">
          {categoryCtas.filter((cta) => cta.href !== canonicalURL && cta.href !== `/guides/category/${category.slug}/`).map((cta) => <a class="secondary-action" href={cta.href}>{cta.label}</a>)}
          <a class="secondary-action" href="/guides/">Browse all guides</a>
        </div>
      </header>

      {categoryGuides.length > 0 ? (
        <section aria-labelledby="category-results-title">
          <h2 class="section-title" id="category-results-title">Guides in this category</h2>
          <div class="guide-related-grid">
            {categoryGuides.map((guide) => (
              <ArticleCard
                title={guide.data.title}
                slug={guide.data.slug}
                category={guide.data.eyebrow ?? (guideCategoryMap[guide.data.category]?.name ?? guide.data.category)}
                status={guide.status}
                description={guide.data.description}
                readingTime={guide.data.readingTime}
                country={guide.meta.country}
                route={guide.meta.route}
                exam={guide.meta.exam}
                level={guide.meta.level}
                updatedDate={guide.data.updatedDate}
                relatedRouteHref="/guides/"
              />
            ))}
          </div>
        </section>
      ) : (
        <p class="guide-empty-state">No source-reviewed guides from this category are currently listed in the Guide Library. Browse the available routes or check another category.</p>
      )}
    </section>
  </main>
</BaseLayout>
