---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import GuideCard from '../../components/GuideCard.astro';
import FilterBar from '../../components/FilterBar.astro';
import SearchInput from '../../components/SearchInput.astro';
import { getCollection } from 'astro:content';
import { guideDiscoveryFilters, guidePurposeLabels, guideStageLabels, inferGuideMeta, resolveGuidePurposes } from '../../data/guide-taxonomy';
import { resolveGuideContentStatus } from '../../data/source-review';
import { getEnglishGuidePublicationPolicy } from '../../data/publication-manifest';
import { getPrimaryDiscoveryZhGuides } from '../../data/guide-library';
import { zhGermanyA1Guides } from '../../data/zh-germany-a1';

const guides = (await getCollection('guides')).map((guide) => {
  const meta = inferGuideMeta(guide.data);
  const purposes = resolveGuidePurposes(guide.data);
  return { ...guide, meta, purposes, status: resolveGuideContentStatus(guide.data) };
}).filter((guide) => getEnglishGuidePublicationPolicy({ slug: guide.data.slug, contentStatus: guide.status, sourceReviewStatus: guide.data.sourceReviewStatus, noindex: guide.data.noindex, adsEligible: guide.data.adsEligible }).index)
  .sort((a, b) => b.data.updatedDate.localeCompare(a.data.updatedDate));
const zhGuides = getPrimaryDiscoveryZhGuides(zhGermanyA1Guides);
const filters = guideDiscoveryFilters.map((filter) => ({ ...filter, options: [...filter.options] }));
const totalGuideCount = guides.length + zhGuides.length;
const jsonLD = { '@context': 'https://schema.org', '@graph': [{ '@type': 'CollectionPage', name: 'VisaLang task guide library', url: 'https://visalang.org/guides/', mainEntity: { '@id': 'https://visalang.org/guides/#items' } }, { '@type': 'ItemList', '@id': 'https://visalang.org/guides/#items', numberOfItems: totalGuideCount, itemListElement: [...guides.map((guide, index) => ({ '@type': 'ListItem', position: index + 1, name: guide.data.title, url: `https://visalang.org/guides/${guide.data.slug}/` })), ...zhGuides.map((guide, index) => ({ '@type': 'ListItem', position: guides.length + index + 1, name: guide.title, url: `https://visalang.org${guide.href}` }))] }] };
---

<BaseLayout title="Task guide library" description="Search language-proof guides by purpose, decision stage, and language." canonicalURL="https://visalang.org/guides/" jsonLD={jsonLD} enableAds={false}>
  <main class="site-main od-guide-library">
    <PageHero compact eyebrow="Task library" title="Find the guide for your next decision." description="This library lists source-reviewed route guides. Research pages stay out of this list until their official sources and distinct reader task have been checked." />
    <section class="library-panel" aria-label="Guide filters">
      <SearchInput />
      <FilterBar filters={filters} />
    </section>
    <section class="content-section guide-results" aria-labelledby="guide-results-title"><h2 class="section-title" id="guide-results-title">Guide results</h2><div class="guide-related-grid" id="guide-grid">{guides.map((guide, index) => <div class="guide-card-wrap" data-title={guide.data.title.toLowerCase()} data-search={`${guide.data.title} ${guide.data.description} ${guide.purposes.map((purpose) => guidePurposeLabels[purpose]).join(' ')} ${guideStageLabels[guide.data.decisionStage]} ${guide.meta.country} ${guide.meta.route} ${guide.meta.exam} ${guide.meta.level}`.toLowerCase()} data-purposes={guide.purposes.join(' ')} data-stage={guide.data.decisionStage} data-language="en" data-updated={guide.data.updatedDate} data-relevance={guide.data.category === 'germany-a1' ? 3 : guide.data.category === 'germany-b1' ? 2 : 1} data-original={index}><GuideCard title={guide.data.title} href={`/guides/${guide.data.slug}/`} value={guide.data.description} country={guide.meta.country} route={guide.meta.route} status={guide.status} updatedDate={guide.data.updatedDate} sourceReviewedAt={guide.data.sourceReviewedAt} sourceReviewStatus={guide.data.sourceReviewStatus} readingTime={guide.data.readingTime} /></div>)}{zhGuides.map((guide, index) => {
      const dataOriginal = guides.length + index;
      const purposes = resolveGuidePurposes(guide);
      return <div class="guide-card-wrap" data-title={guide.title.toLowerCase()} data-search={`${guide.title} ${guide.description} ${purposes.map((purpose) => guidePurposeLabels[purpose]).join(' ')} ${guideStageLabels[guide.decisionStage]} 德国 家庭团聚 A1 中文`.toLowerCase()} data-purposes={purposes.join(' ')} data-stage={guide.decisionStage} data-language="zh" data-updated={guide.updatedDate} data-relevance="3" data-original={dataOriginal}><GuideCard title={guide.title} href={guide.href} value={guide.description} country="Germany" route="Family reunion" status={guide.status} updatedDate={guide.updatedDate} sourceReviewedAt={guide.sourceReviewedAt} sourceReviewStatus={guide.sourceReviewStatus} readingTime={guide.readingTime} language="中文" /></div>;
    })}</div><div class="guide-empty-state" hidden><h2>No matching guide</h2><p>Clear a narrow filter or start with Purpose and Stage. If your route is not supported, use Route Finder to prepare an official check.</p><div class="action-row left"><button class="button button--secondary" type="button" data-empty-clear-all>Clear all filters</button><a class="button button--secondary" href="/tools/route-finder/">Open Route Finder</a></div></div></section>
  </main>
  <script>
    import {
      clearGuideDiscoveryState,
      filterGuideDiscoveryCards,
      parseGuideDiscoveryState,
      serializeGuideDiscoveryState,
      summarizeGuideDiscoveryResults,
    } from '../../data/guide-discovery';

    (() => {
      const grid = document.querySelector('#guide-grid');
      const cards = [...document.querySelectorAll('.guide-card-wrap')];
      const search = document.querySelector('[data-guide-search]');
      const filters = [...document.querySelectorAll('[data-guide-filter]')];
      const sort = document.querySelector('[data-guide-sort]');
      const status = document.querySelector('.filter-status');
      const empty = document.querySelector('.guide-empty-state');
      const activeFilters = document.querySelector('[data-active-filters]');
      const activeFilterList = document.querySelector('.active-filter-list');
      const clearAll = document.querySelector('[data-clear-all]');
      const emptyClearAll = document.querySelector('[data-empty-clear-all]');
      const filterLabels = Object.fromEntries(filters.map((filter) => [filter.name, filter.closest('label')?.querySelector('span')?.textContent || filter.name]));
      const stateFromControls = () => {
        const values = Object.fromEntries(filters.map((filter) => [filter.name, filter.value]));
        return {
          q: search.value.trim(),
          purpose: values.purpose || '',
          stage: values.stage || '',
          language: values.language || '',
          sort: sort.value,
        };
      };
      const cardRecords = cards.map((card) => ({
        element: card,
        search: card.dataset.search || '',
        purposes: (card.dataset.purposes || '').split(' ').filter(Boolean),
        stage: card.dataset.stage || 'requirement',
        language: card.dataset.language || 'en',
      }));
      const setControls = (state) => {
        search.value = state.q;
        filters.forEach((filter) => { filter.value = state[filter.name] || ''; });
        sort.value = state.sort;
      };
      const apply = () => {
        const state = stateFromControls();
        const visibleCards = new Set(filterGuideDiscoveryCards(cardRecords, state).map((record) => record.element));
        cards.forEach((card) => { card.hidden = !visibleCards.has(card); });
        const sorted = [...cards].sort((a, b) => state.sort === 'updated' ? b.dataset.updated.localeCompare(a.dataset.updated) : Number(b.dataset.relevance) - Number(a.dataset.relevance) || Number(a.dataset.original) - Number(b.dataset.original));
        sorted.forEach((card) => grid.append(card));
        const resultState = summarizeGuideDiscoveryResults(visibleCards.size, cards.length);
        status.textContent = resultState.announcement;
        empty.hidden = !resultState.empty;
        const active = [
          ...(search.value.trim() ? [{ name: 'q', label: 'Search', value: search.value.trim() }] : []),
          ...filters.filter((filter) => filter.value).map((filter) => ({ name: filter.name, label: filterLabels[filter.name], value: filter.options[filter.selectedIndex]?.text || filter.value })),
          ...(sort.value !== 'updated' ? [{ name: 'sort', label: 'Sort', value: sort.options[sort.selectedIndex]?.text || sort.value }] : []),
        ];
        activeFilterList.replaceChildren(...active.map((item) => {
          const button = document.createElement('button');
          button.type = 'button';
          button.className = 'active-filter-chip';
          button.dataset.removeFilter = item.name;
          button.setAttribute('aria-label', `Remove ${item.label}: ${item.value}`);
          button.textContent = `${item.label}: ${item.value} ×`;
          return button;
        }));
        activeFilters.hidden = active.length === 0;
        clearAll.disabled = active.length === 0;
        const query = serializeGuideDiscoveryState(state);
        history.replaceState(null, '', query ? `/guides/?${query}` : '/guides/');
      };
      setControls(parseGuideDiscoveryState(location.search));
      search.addEventListener('input', apply);
      filters.forEach((filter) => filter.addEventListener('change', apply));
      sort.addEventListener('change', apply);
      activeFilterList.addEventListener('click', (event) => {
        if (!(event.target instanceof Element)) return;
        const button = event.target.closest('[data-remove-filter]');
        if (!button) return;
        const filterName = button.dataset.removeFilter;
        const focusTarget = filterName === 'q'
          ? search
          : filterName === 'sort'
            ? sort
            : filters.find((item) => item.name === filterName);
        if (filterName === 'q') search.value = '';
        else if (filterName === 'sort') sort.value = 'updated';
        else {
          const filter = filters.find((item) => item.name === filterName);
          if (filter) filter.value = '';
        }
        apply();
        focusTarget?.focus();
      });
      const clear = () => {
        setControls(clearGuideDiscoveryState());
        apply();
        search.focus();
      };
      clearAll.addEventListener('click', clear);
      emptyClearAll.addEventListener('click', clear);
      document.querySelector('[data-filter-form]')?.addEventListener('submit', (event) => event.preventDefault());
      apply();
      search.disabled = false;
      filters.forEach((filter) => { filter.disabled = false; });
      sort.disabled = false;
    })();
  </script>
</BaseLayout>
