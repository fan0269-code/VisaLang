---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import { exams } from '../../data/app-data';
const grouped = exams.reduce<Record<string, typeof exams>>((result, exam) => {
  (result[exam.country] ||= []).push(exam);
  return result;
}, {});
---
<BaseLayout title="Match an exam to the route" description="Use the Germany A1 and B1 comparisons before booking. The directory lists official exam sites and is not proof of acceptance." canonicalURL="https://visalang.org/exams/">
  <main class="site-main">
    <PageHero compact title="Compare exams only after you know the route." description="An exam brand is not proof of acceptance. Match the exact certificate and level to the receiving organisation." primary={{ href: '/tools/exam-comparison/', label: 'Compare configured exams' }} secondary={{ href: '/guides/', label: 'Browse exam guides' }} />
    <section class="content-section" aria-labelledby="germany-exam-guides"><div class="section-header"><h2 id="germany-exam-guides">Start with the developed Germany comparisons</h2><p>Read the route hub first. These guides compare named products only after an authority has a proof question.</p></div><div class="guide-related-grid"><a class="article-card" href="/guides/goethe-a1-vs-telc-a1/"><h3>Goethe A1 and telc A1</h3><p class="card-meta">Family-reunion comparison. Acceptance still depends on the mission or authority.</p></a><a class="article-card" href="/guides/goethe-b1-vs-telc-b1/"><h3>DTZ, Goethe B1, and telc B1</h3><p class="card-meta">Settlement and citizenship comparison. Do not treat one brand as approval.</p></a><a class="article-card" href="/germany-family-reunion-a1/"><h3>Germany A1 hub</h3><p class="card-meta">The family-reunion sequence before any booking.</p></a><a class="article-card" href="/germany-b1-settlement-citizenship/"><h3>Germany B1 hub</h3><p class="card-meta">Settlement and citizenship sequence before any booking.</p></a></div></section>
    <section class="content-section" aria-labelledby="exam-list-title"><div class="section-header"><h2 id="exam-list-title">Exam directory</h2><p>Official starting points only. A listing is not a VisaLang decision path, and it does not mean the exam fits an immigration, study, or licensing route.</p></div>{Object.entries(grouped).map(([country, items]) => <section><h3>{country}</h3><div class="guide-related-grid">{items?.map((exam) => <a class="source-card" href={exam.officialSource}><div><h4>{exam.name}</h4><p>{exam.category}</p><span class="last-checked">Directory entry updated: <time datetime={exam.lastUpdated}>{exam.lastUpdated}</time></span></div><span>Official source</span></a>)}</div></section>)}</section>
  </main>
</BaseLayout>
