---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import { configuredExams, referenceExams } from '../../data/app-data';
const grouped = referenceExams.reduce<Record<string, typeof referenceExams>>((result, exam) => {
  (result[exam.country] ||= []).push(exam);
  return result;
}, {});
---
<BaseLayout title="Language exams" description="Browse exam families, then verify the exact certificate against your route before booking." canonicalURL="https://visalang.org/exams/">
  <main class="site-main">
    <PageHero compact title="Compare exams only after you know the route." description="An exam brand is not proof of acceptance. Match the exact certificate and level to the receiving organisation." primary={{ href: '/tools/exam-comparison/', label: 'Compare configured exams' }} secondary={{ href: '/guides/', label: 'Browse exam guides' }} />
    <section class="content-section" aria-labelledby="supported-exams-title">
      <div class="section-header"><h2 id="supported-exams-title">Supported A1 and B1 comparisons</h2><p>VisaLang currently maintains source-reviewed product facts for these four exact adult A1 and B1 products. This support does not establish local availability or acceptance for an application.</p></div>
      <div class="guide-related-grid">{configuredExams.map((exam) => <a class="source-card" href={exam.officialSource}><div><h3>{exam.name}</h3><p>{exam.scope}</p><span class="last-checked">Product source checked: <time datetime={exam.lastUpdated}>{exam.lastUpdated}</time></span></div><span>Official product source</span></a>)}</div>
    </section>
    <section class="content-section" aria-labelledby="exam-list-title"><div class="section-header"><h2 id="exam-list-title">Reference directory</h2><p>These retained entries provide official starting points only. They are not configured VisaLang comparisons and do not state that an exam applies to an immigration, study, licensing, or work route.</p></div>{Object.entries(grouped).map(([country, items]) => <section><h3>{country}</h3><div class="guide-related-grid">{items?.map((exam) => <a class="source-card" href={exam.officialSource}><div><h3>{exam.name}</h3><p>{exam.category} · Reference only</p><span class="last-checked">Directory entry updated: <time datetime={exam.lastUpdated}>{exam.lastUpdated}</time></span></div><span>Official source</span></a>)}</div></section>)}</section>
  </main>
</BaseLayout>
