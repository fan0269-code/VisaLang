---
import BaseLayout from './BaseLayout.astro';
import ToolShell from '../components/tools/ToolShell.astro';
import { translatedPaths } from '../data/site';
import type { ToolLocale } from '../data/tool-copy';
export interface Props { title: string; description: string; eyebrow: string; current: 'finder' | 'checklist' | 'timeline' | 'comparison' | 'reminders'; locale?: ToolLocale; }
const { title, description, eyebrow, current, locale = 'en' } = Astro.props;
const canonicalURL = `https://visalang.org${Astro.url.pathname}`;
const pair = locale === 'zh-CN'
  ? Object.entries(translatedPaths).find(([, zhPath]) => zhPath === Astro.url.pathname)
  : translatedPaths[Astro.url.pathname] ? [Astro.url.pathname, translatedPaths[Astro.url.pathname]] : undefined;
const alternates = pair ? [
  { lang: 'en', href: `https://visalang.org${pair[0]}` },
  { lang: 'zh-CN', href: `https://visalang.org${pair[1]}` },
  { lang: 'x-default', href: `https://visalang.org${pair[0]}` },
] : [];
const jsonLD = { '@context': 'https://schema.org', '@type': 'WebApplication', name: title, description, url: canonicalURL, applicationCategory: 'UtilitiesApplication', operatingSystem: 'Any', offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' } };
---
<BaseLayout title={title} description={description} canonicalURL={canonicalURL} lang={locale} alternates={alternates} jsonLD={jsonLD} enableAds={false}>
  <ToolShell eyebrow={eyebrow} title={title} description={description} current={current} locale={locale}><slot /></ToolShell>
</BaseLayout>
